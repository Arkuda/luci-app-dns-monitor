#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: ISC
START=18
STOP=18
USE_PROCD=1

start_service() {
    local records bytes seconds
    config_load dns-monitor
    config_get records config max_records 10000
    config_get bytes config max_log_bytes 5242880
    config_get seconds config session_seconds 3600
    # The daemon validates numeric ranges as well; never interpret config as shell code.
    procd_open_instance monitor
    procd_set_param command /usr/sbin/dns-monitor --max-records "$records" --max-log-bytes "$bytes" --session-seconds "$seconds"
    procd_set_param respawn 3600 1 0
    procd_set_param term_timeout 40
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

boot() {
    # Restore a configuration-only journal before dnsmasq (START=19) starts.
    /usr/libexec/dns-monitor-lifecycle recover || return 1
    start
}

stop_service() {
    # Keep capture running until dnsmasq has safely switched off query logging.
    local result
    result=$(ubus -t 35 call dns-monitor stop 2>/dev/null || true)
    [ "$(printf '%s' "$result" | jsonfilter -e '@.active' 2>/dev/null)" = false ] && return 0
    # exit, not return: rc.common must not kill the collector on failed restoration.
    /usr/libexec/dns-monitor-lifecycle recover || exit 1
}

service_stopped() {
    # Also covers termination before the daemon registered its ubus object.
    /usr/libexec/dns-monitor-lifecycle recover
}

service_triggers() {
    procd_add_reload_trigger dns-monitor
}
